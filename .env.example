# =============================================================================
# One company per deployment. Copy to .env.local and fill in per-company values.
# =============================================================================

# --- Site ---
# Public site URL (used for QR generation and absolute links)
NEXT_PUBLIC_APP_URL=https://shop.example.com

# --- Catalog (client-visible slug + server-side metadata) ---
NEXT_PUBLIC_CATALOG_SLUG=example
CATALOG_TITLE=Example Catalog 2026
CATALOG_EDITION=2026-Q2
CATALOG_TAGLINE=Scan an article QR code in the catalog to order via this shop.

# Where the catalog forwards article/cart orders (no per-Händler URL in Phase 1).
# Falls back to NEXT_PUBLIC_SHOP_BASE_URL when omitted.
# When both are unset, checkout uses the inquiry form + SMTP email instead.
NEXT_PUBLIC_CATALOG_FORWARD_URL=https://shop.example.com/order
# OXID shop root for basket addtoCart redirect (defaults to MERZLJAK_API_BASE_URL)
NEXT_PUBLIC_SHOP_BASE_URL=https://shop.example.com
# Force checkout mode: shop | inquiry (auto-detected from URLs when omitted)
# NEXT_PUBLIC_CATALOG_ORDER_MODE=inquiry

# --- Merzljak OXID shop API (the only product data source) ---
# Base URL = shop root, e.g. https://shop.example.com (no trailing slash)
MERZLJAK_API_BASE_URL=https://shop.example.com
MERZLJAK_API_USERNAME=api@example.com
MERZLJAK_API_PASSWORD=your_api_password
# Product image host. If omitted, MERZLJAK_API_BASE_URL is used.
MERZLJAK_IMAGE_BASE_URL=https://shop.example.com
# Optional: map SKU → OXID id when the API has no oxid field
# MOCK_OXID_BY_SKU={"12345":"b56597806428de2f58b1c6c7d3e0e093"}

# Secret for signing scan-grant cookies (blocks direct /article/{sku} without scan).
# Falls back to MERZLJAK_API_PASSWORD when unset.
# SCAN_GRANT_SECRET=replace-with-a-long-random-string

# --- Company information (footer, page metadata) ---
COMPANY_NAME=Example GmbH
COMPANY_STREET=Example Street 1
COMPANY_CITY=12345 Example City
COMPANY_COUNTRY=Deutschland
COMPANY_PHONE=000 - 00 00 00 - 0
COMPANY_EMAIL=noreply@example.com
COMPANY_WEBSITE=www.example.com
COMPANY_WEBSITE_URL=https://www.example.com
COMPANY_KONTAKT_URL=https://www.example.com/kontakt
COMPANY_IMPRESSUM_URL=https://www.example.com/impressum

# --- Order inquiry (when no shop checkout URLs are configured) ---
# Recipient for catalog inquiry emails (defaults to COMPANY_EMAIL)
# ORDER_INQUIRY_TO_EMAIL=orders@example.com
# SMTP with TLS (STARTTLS) — typical: port 587, SMTP_SECURE=false
SMTP_HOST=ssl.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="Katalog Anfrage <noreply@example.com>"

# --- Geo (optional; reseller routing is currently dormant) ---
# Default region when IP is localhost/private (development)
DEFAULT_GEO_REGION=Saarland
# Path to MaxMind GeoLite2-City.mmdb (download via npm run geo:download)
# MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb
# MAXMIND_LICENSE_KEY=your_license_key

# --- QR generation (npm run qr:generate) ---
# Comma-separated article SKUs to encode as article QR codes
QR_SKUS=12345,67890
# QR foreground color (defaults to #195084)
# QR_DARK_COLOR=#195084

# --- Theme colors (override fallbacks in src/lib/theme.ts) ---
# See .env.local / src/lib/theme.ts for the full THEME_COLOR_* list.
# THEME_COLOR_BLACK=#212529
